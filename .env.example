# MyJDownloader credentials (never commit the real .env)
MYJD_EMAIL=
MYJD_PASSWORD=
# Optional: device name to use by default
MYJD_DEVICE=
PORT=20031
# Password protecting the UI/API (HTTP Basic auth, any username). Strongly recommended.
UI_PASSWORD=
# Address under which the JDownloader reaches this app (enables registering as external captcha solver)
JD_SOLVER_URL=
