# MyJDownloader credentials (never commit the real .env)
MYJD_EMAIL=
MYJD_PASSWORD=
# Optional: device name to use by default
MYJD_DEVICE=
# Host port under which the app is reachable from outside (container-internal port is fixed)
APP_PORT=3000
# Password protecting the UI/API (HTTP Basic auth, any username). Strongly recommended.
UI_PASSWORD=
# Address under which the JDownloader reaches this app (enables registering as external captcha solver)
JD_SOLVER_URL=
# MCP server on /mcp (same password as the UI). Read-only unless set to true (then set/reset settings and add links are possible); the switch on the settings page overrides this.
MCP_WRITE=
# Firefox extension (optional): release Firefox installs only what Mozilla signed, so the backend has it signed with your own AMO API keys
# (addons.mozilla.org > Tools > Manage API Keys; the package stays unlisted). Needs PUBLIC_URL, the https address this app is reached at
# (Firefox updates an extension only over https), e.g. https://myjd.example.org
PUBLIC_URL=
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
# Add-on id: one AMO account per id, so every installation makes its own (kept in the data folder); set it only to choose one
EXTENSION_FIREFOX_ID=
